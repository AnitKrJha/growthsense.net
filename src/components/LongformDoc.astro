---
/**
 * Long-form reading layout for legal pages: a numbered document on a sheet, with a sticky
 * contents list on desktop (collapsible on mobile) that highlights the section in view.
 * Each `toc` id must match an h2 id in the slot content.
 */
interface Props {
  toc: { id: string; title: string }[];
  lastUpdated: string;
  /** Short doc reference for the meta strip, e.g. "PRV-01". */
  docRef: string;
}
const { toc, lastUpdated, docRef } = Astro.props;
---
<section class="doc-wrap">
  <div class="container doc-grid">
    <nav class="doc-toc" aria-label="On this page">
      <details class="toc-details" open>
        <summary class="toc-title">Contents</summary>
        <ol class="toc-list" role="list">
          {toc.map((t, i) => (
            <li>
              <a href={`#${t.id}`} data-toc={t.id}>
                <span class="toc-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span>{t.title}</span>
              </a>
            </li>
          ))}
        </ol>
      </details>
    </nav>

    <article class="doc sheet">
      <p class="doc-meta">
        <span>Ref · {docRef}</span>
        <span>Last updated · <time>{lastUpdated}</time></span>
      </p>
      <div class="doc-body prose">
        <slot />
      </div>
    </article>
  </div>
</section>

<script>
  // Highlight the contents entry for the section currently in view. Progressive enhancement only.
  function initToc() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.doc-toc a[data-toc]'));
    if (!links.length || !('IntersectionObserver' in window)) return;
    // On small screens the contents start collapsed so the document comes first.
    const details = document.querySelector<HTMLDetailsElement>('.toc-details');
    if (details && window.matchMedia('(max-width: 59.99rem)').matches) details.open = false;
    const byId = new Map(links.map((a) => [a.dataset.toc!, a]));
    const headings = links.map((a) => document.getElementById(a.dataset.toc!)).filter((h): h is HTMLElement => !!h);
    const visible = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id);
        const current = headings.find((h) => visible.has(h.id));
        if (!current) return;
        for (const [id, a] of byId) {
          if (id === current.id) a.setAttribute('aria-current', 'location');
          else a.removeAttribute('aria-current');
        }
      },
      { rootMargin: '-15% 0px -70% 0px' },
    );
    headings.forEach((h) => io.observe(h));
  }
  initToc();
</script>

<style>
  .doc-wrap {
    padding-bottom: var(--space-2xl);
  }
  .doc-grid {
    display: grid;
    gap: var(--space-m);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .doc-grid {
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: var(--space-xl);
    }
    .doc-toc {
      position: sticky;
      top: calc(var(--header-h) + var(--space-m));
    }
    .toc-title {
      pointer-events: none;
    }
    .toc-title::after {
      display: none;
    }
  }

  /* ---------- contents ---------- */
  .toc-title {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: var(--tap);
    list-style: none;
    cursor: pointer;
    font-family: var(--font-paper);
    font-size: var(--step--2);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--graphite-700);
    border-bottom: 1.5px solid var(--graphite-900);
  }
  .toc-title::-webkit-details-marker {
    display: none;
  }
  .toc-title::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--forest-700);
  }
  .toc-details[open] .toc-title::after {
    content: '–';
  }
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .toc-list li {
    margin: 0;
    border-bottom: 1px solid var(--paper-300);
  }
  .toc-list a {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    gap: var(--space-2xs);
    align-items: baseline;
    min-height: var(--tap);
    padding: 0.65rem 0.25rem 0.6rem;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--graphite-700);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .toc-list a:hover {
    color: var(--graphite-900);
    background: var(--highlight);
  }
  .toc-list a[aria-current] {
    color: var(--forest-700);
    font-weight: 650;
  }
  .toc-list a[aria-current] .toc-no {
    color: var(--stamp-700);
  }
  .toc-no {
    font-family: var(--font-paper);
    font-size: var(--step--2);
    color: var(--graphite-500);
  }

  /* ---------- the document ---------- */
  .doc {
    --sheet-pad: clamp(1.25rem, 0.5rem + 3.5vw, 4rem);
    counter-reset: doc-section;
  }
  .doc-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    margin: 0 0 var(--space-l);
    padding-bottom: var(--space-2xs);
    font-family: var(--font-paper);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--graphite-500);
    border-bottom: 1px dashed var(--paper-300);
  }
  .doc-body {
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .doc-body :global(h2) {
    counter-increment: doc-section;
    display: flex;
    gap: 0.6em;
    align-items: baseline;
    margin-top: var(--space-xl);
    padding-top: var(--space-s);
    border-top: 1px solid var(--paper-300);
    font-size: var(--step-2);
    scroll-margin-top: calc(var(--header-h) + var(--space-m));
  }
  .doc-body :global(h2::before) {
    content: counter(doc-section, decimal-leading-zero);
    font-family: var(--font-paper);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--stamp-700);
    transform: translateY(-0.2em);
  }
  .doc-body :global(h2:first-of-type) {
    margin-top: var(--space-l);
  }
  .doc-body :global(h3) {
    font-size: 1.125rem;
    font-family: var(--font-text);
    font-weight: 700;
    letter-spacing: 0;
  }
  .doc-body :global(.notice) {
    margin-block: var(--space-m);
  }
  .doc-body :global(.doc-key) {
    margin: var(--space-m) 0;
    padding: var(--space-s) var(--space-m);
    font-weight: 600;
    background: var(--mint-100);
    border-radius: var(--radius-paper);
  }
  .doc-body :global(.doc-end) {
    margin-top: var(--space-xl);
    padding-top: var(--space-s);
    border-top: 1.5px solid var(--graphite-900);
    font-size: var(--step--1);
    color: var(--graphite-500);
  }

  @media print {
    .doc-toc {
      display: none;
    }
    .doc-grid {
      display: block;
    }
  }
</style>
