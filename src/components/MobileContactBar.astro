---
/**
 * Floating WhatsApp button, below 60rem only (desktop has the header's WhatsApp pill).
 * WhatsApp is the primary channel; Call stays available in the header menu and on every page's contact blocks.
 * Slides away while the header menu sheet is open (the menu marks it inert).
 */
import { FaWhatsapp } from 'react-icons/fa';
import { whatsappUrl, defaultWhatsappMessage } from '@/lib/contact';
interface Props { topic?: string }
const wa = whatsappUrl(defaultWhatsappMessage(Astro.props.topic));
---
<a
  class="wa-fab no-print"
  href={wa ?? '/contact'}
  target={wa ? '_blank' : undefined}
  rel={wa ? 'noopener' : undefined}
  aria-label="Chat on WhatsApp"
  data-inert-when-menu
>
  <FaWhatsapp aria-hidden="true" />
  <span class="wa-fab__label" aria-hidden="true">WhatsApp</span>
</a>
<style>
  .wa-fab {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: calc(1rem + env(safe-area-inset-bottom));
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 56px;
    padding: 0 1.25rem 0 1.05rem;
    border-radius: var(--radius-pill);
    background: var(--whatsapp);
    color: var(--paper-50);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    box-shadow:
      0 2px 4px oklch(0.2 0.03 150 / 0.2),
      0 12px 28px -8px oklch(0.2 0.05 150 / 0.55);
    view-transition-name: wa-fab;
    transition:
      transform var(--dur) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }
  .wa-fab :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
  }
  .wa-fab:hover {
    background: var(--whatsapp-hover);
    color: var(--paper-50);
  }
  .wa-fab:active {
    transform: scale(0.97);
  }
  .wa-fab:focus-visible {
    outline: 3px solid var(--carbon-600);
    outline-offset: 3px;
  }
  /* A soft attention ring once after load; off under reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .wa-fab::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      box-shadow: 0 0 0 0 oklch(0.52 0.13 150 / 0.45);
      animation: wa-ring 1.6s var(--ease-out) 2.5s 2;
      pointer-events: none;
    }
  }
  @keyframes wa-ring {
    to {
      box-shadow: 0 0 0 14px oklch(0.52 0.13 150 / 0);
    }
  }
  .wa-fab[inert] {
    transform: translateY(calc(100% + 2rem));
  }
  @media (min-width: 60rem) {
    .wa-fab {
      display: none;
    }
  }
</style>
