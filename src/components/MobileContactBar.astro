---
/** Sticky call + WhatsApp bar, mobile only. */
import { Phone } from 'lucide-react';
import { FaWhatsapp } from 'react-icons/fa';
import { whatsappUrl, telUrl, defaultWhatsappMessage } from '@/lib/contact';
interface Props { topic?: string }
const wa = whatsappUrl(defaultWhatsappMessage(Astro.props.topic));
const tel = telUrl();
---
<div class="mobile-bar" role="region" aria-label="Quick contact">
  <a class="btn btn--primary" href={tel ?? '/contact'}><Phone aria-hidden="true" /> Call</a>
  <a class="btn btn--whatsapp" href={wa ?? '/contact'} target={wa ? '_blank' : undefined} rel={wa ? 'noopener' : undefined}><FaWhatsapp aria-hidden="true" /> WhatsApp</a>
</div>
<style>
  .mobile-bar {
    position: fixed; inset: auto 0 0 0; z-index: 60; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-2);
    padding: var(--space-2) var(--space-3) calc(var(--space-2) + env(safe-area-inset-bottom));
    background: var(--surface); border-top: 1px solid var(--line); box-shadow: 0 -4px 16px rgb(20 30 25 / 0.06);
  }
  .mobile-bar .btn { width: 100%; }
  @media (min-width: 60rem) { .mobile-bar { display: none; } }
</style>
