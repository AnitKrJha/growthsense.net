---
import { Phone, Mail } from 'lucide-react';
import { FaWhatsapp } from 'react-icons/fa';
import { whatsappUrl, telUrl, mailtoUrl, defaultWhatsappMessage } from '@/lib/contact';

interface Props {
  /** Topic used in the pre-filled WhatsApp message, e.g. "GST registration". */
  topic?: string;
  showEmail?: boolean;
  class?: string;
}
const { topic, showEmail = false, class: cls } = Astro.props;
const wa = whatsappUrl(defaultWhatsappMessage(topic));
const tel = telUrl();
const mail = mailtoUrl(topic ? `Enquiry: ${topic}` : 'Enquiry');
---
<div class:list={['cluster', cls]}>
  {wa ? (
    <a class="btn btn--whatsapp" href={wa} target="_blank" rel="noopener"><FaWhatsapp aria-hidden="true" /> WhatsApp</a>
  ) : (
    <a class="btn btn--whatsapp" href="/contact" title="TODO: WhatsApp number not set"><FaWhatsapp aria-hidden="true" /> WhatsApp</a>
  )}
  {tel ? (
    <a class="btn btn--primary" href={tel}><Phone aria-hidden="true" /> Call</a>
  ) : (
    <a class="btn btn--primary" href="/contact" title="TODO: phone number not set"><Phone aria-hidden="true" /> Call</a>
  )}
  {showEmail && mail && <a class="btn btn--ghost" href={mail}><Mail aria-hidden="true" /> Email</a>}
</div>
