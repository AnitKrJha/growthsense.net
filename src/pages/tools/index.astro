---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import CtaBand from '@/components/CtaBand.astro';
import { ArrowRight, CalendarClock, Calculator, House, Percent, ReceiptIndianRupee } from 'lucide-react';
import { toolNav } from '@/config/nav';
import { site } from '@/config/site';
import { breadcrumbLd } from '@/lib/schema';

const siteUrl = Astro.site ?? new URL('https://example.com');
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Calculators', path: '/tools' },
];
const near = site.location.city ? ` in ${site.location.city}` : '';

const icons: Record<string, typeof Calculator> = {
  '/tools/income-tax-calculator': Calculator,
  '/tools/hra-calculator': House,
  '/tools/gst-calculator': ReceiptIndianRupee,
  '/tools/advance-tax': CalendarClock,
  '/tools/tds-calculator': Percent,
};

const itemListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: toolNav.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.title,
    url: new URL(t.href, siteUrl).toString(),
  })),
};
---
<BaseLayout
  title="Free tax calculators: income tax, HRA, GST, advance tax, TDS"
  description={`Free calculators for Indian taxpayers: income tax (old vs new regime), HRA exemption, GST, advance tax and TDS rates. Quick estimates, plus filing help${near} when you need it.`}
  jsonLd={[breadcrumbLd(siteUrl, crumbs), itemListLd]}
>
  <PageHeader
    title="Tax calculators"
    lead="Quick, private estimates that run in your browser. Nothing you type is stored or sent unless you choose to share it."
    crumbs={crumbs}
  />
  <section class="section">
    <div class="container">
      <ul class="tool-grid" role="list">
        {toolNav.map((t) => {
          const Icon = icons[t.href] ?? Calculator;
          return (
            <li>
              <a class="card card--link tool-card" href={t.href}>
                <span class="icon-badge tool-icon"><Icon aria-hidden="true" /></span>
                <h2 class="tool-title">{t.title}</h2>
                <p class="muted">{t.short}</p>
                <span class="tool-go" aria-hidden="true">
                  Open <ArrowRight />
                </span>
              </a>
            </li>
          );
        })}
      </ul>
      <p class="muted small tool-disclaimer">
        All results are estimates for information only, not tax, legal or financial advice. Rates and rules can change
        with each Budget: check the official portals at
        <a href="https://www.incometax.gov.in" rel="noopener" target="_blank">incometax.gov.in</a> and
        <a href="https://www.gst.gov.in" rel="noopener" target="_blank">gst.gov.in</a>.
        <a href="/disclaimer">Read the disclaimer</a>.
      </p>
    </div>
  </section>
  <CtaBand title="Rather have someone file it for you?" />
</BaseLayout>

<style>
  /* Minimal layout only; visual design is handled in a later pass. Hover lift comes from .card--link. */
  .tool-grid {
    list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  .tool-grid li { margin: 0; }
  .tool-card { height: 100%; display: flex; flex-direction: column; }
  .tool-title { font-size: 1.25rem; margin: 0 0 var(--space-2); }
  .tool-card p { flex: 1; }
  .tool-go { display: inline-flex; align-items: center; gap: var(--space-1); margin-top: var(--space-4); color: var(--accent); font-weight: 600; }
  .tool-go :global(svg) { width: 1rem; height: 1rem; }
  .tool-disclaimer { margin-top: var(--space-6); max-width: var(--measure); }
</style>
