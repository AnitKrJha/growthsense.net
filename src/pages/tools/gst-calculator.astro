---
import ToolShell from '@/components/tools/ToolShell.astro';
import GstCalculator from '@/components/tools/GstCalculator';
import Faq from '@/components/Faq.astro';
import { faqLd } from '@/lib/schema';
import { site } from '@/config/site';

const near = site.location.city ? ` in ${site.location.city}` : '';

const faqs = [
  {
    question: 'When do I charge CGST + SGST and when IGST?',
    answer:
      'If the supplier and the place of supply are in the same state or union territory, the supply is intra-state and GST is split equally into CGST and SGST (or UTGST). If they are in different states, the supply is inter-state and the full rate is charged as IGST.',
  },
  {
    question: 'How do I remove GST from an amount that already includes it?',
    answer:
      'Divide the amount by (1 + rate / 100) to get the taxable value. For example, 1,180 including 18% GST is 1,180 / 1.18 = 1,000 taxable value plus 180 GST. Choose "Remove GST" above to do this automatically.',
  },
  {
    question: 'What are the GST rates after 22 September 2025?',
    answer:
      'After the GST rate rationalisation that took effect on 22 September 2025, most goods and services fall under 5% or 18%, with 40% for certain sin and luxury goods. Special rates such as 0%, 0.25% and 3% continue for specific items. The rate for your item depends on its HSN or SAC code, so check it on cbic-gst.gov.in.',
  },
  {
    question: 'Is this calculator enough to file my GST return?',
    answer:
      'No. It helps you check invoice figures. Filing GSTR-1 and GSTR-3B needs your full sales, purchases and input tax credit details on gst.gov.in. You can ask for help with registration and returns.',
  },
];
---
<ToolShell
  title="GST calculator"
  seoTitle="GST calculator India: add or remove GST, CGST/SGST and IGST split"
  description={`Free GST calculator for India. Add or remove GST at 5%, 18%, 40% and special rates, and see the CGST + SGST or IGST split to the paisa. Help with GST returns${near} too.`}
  lead="Add GST to a price or take it out of an inclusive amount, and see the CGST + SGST or IGST split."
  verifiedNote="GST rates are unverified as of 26 Sep 2026. They reflect the rate changes effective 22 Sep 2025 as we understand them. Check the rate for your HSN/SAC code on cbic-gst.gov.in."
  ctaTopic="GST registration / returns"
>
  <GstCalculator client:visible />
  <Fragment slot="after">
    <div class="prose tool-after">
      <h2>How GST is worked out</h2>
      <p>
        <strong>Adding GST:</strong> GST = taxable value × rate. For an 18% item worth ₹1,000, GST is ₹180 and the
        invoice total is ₹1,180.
      </p>
      <p>
        <strong>Removing GST:</strong> taxable value = inclusive amount ÷ (1 + rate). ₹1,180 including 18% GST is
        ₹1,000 plus ₹180 GST.
      </p>
      <p>
        <strong>Within a state</strong>, the tax is split into equal halves of CGST and SGST (UTGST in union
        territories). <strong>Between states</strong>, the whole amount is IGST. The total tax is the same either way,
        apart from paise-level rounding.
      </p>
      <p>
        Official sources: <a href="https://cbic-gst.gov.in" rel="noopener" target="_blank">cbic-gst.gov.in</a> for
        rate notifications and <a href="https://www.gst.gov.in" rel="noopener" target="_blank">gst.gov.in</a> for
        registration and returns.
      </p>
      <h2>Frequently asked questions</h2>
      <Faq faqs={faqs} />
    </div>
    <script type="application/ld+json" set:html={JSON.stringify(faqLd(faqs))} />
  </Fragment>
</ToolShell>

<style>
  .tool-after { margin-top: var(--space-7); }
</style>
