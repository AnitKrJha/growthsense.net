---
/**
 * Home: "Paperwork → Filed". Order per DESIGN.md §6:
 * hero (desk) → flap board → services folders → receipt → slab staircase (desk) → not included → FAQ → WhatsApp chat CTA.
 * Copy lives in src/content/home.ts and src/components/home/copy.ts. Sections are self-contained in src/components/home/.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/hero/Hero.astro';
import FlapBoard from '@/components/home/FlapBoard';
import MotionBoot from '@/components/home/MotionBoot.astro';
import ServicesFolders from '@/components/home/ServicesFolders.astro';
import HowItWorksReceipt from '@/components/home/HowItWorksReceipt.astro';
import CalculatorsTeaser from '@/components/home/CalculatorsTeaser.astro';
import NotIncluded from '@/components/home/NotIncluded.astro';
import FaqTeaser from '@/components/home/FaqTeaser.astro';
import ChatCta from '@/components/home/ChatCta.astro';
import { allFaqs } from '@/content/faqs';
import { faqTeaser, homeMeta } from '@/content/home';
import { faqLd } from '@/lib/schema';

const faqs = allFaqs.slice(0, faqTeaser.count);
// FAQ answers may carry simple HTML (links); JSON-LD gets plain text.
const plain = (html: string) => html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
const jsonLd = [faqLd(faqs.map((f) => ({ question: f.question, answer: plain(f.answer) })))];
---
<BaseLayout description={homeMeta.description} jsonLd={jsonLd}>
  <Hero />
  <FlapBoard client:visible />
  <MotionBoot />
  <ServicesFolders />
  <HowItWorksReceipt />
  <CalculatorsTeaser />
  <NotIncluded />
  <FaqTeaser faqs={faqs} />
  <ChatCta />
</BaseLayout>
