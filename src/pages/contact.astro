---
/**
 * Contact: an "enquiry slip" sheet (the form) beside a desk panel of direct channels.
 * WhatsApp is the primary channel, so it is the largest action on the page.
 */
import { Clock, Mail, MapPin, Phone } from 'lucide-react';
import { FaWhatsapp } from 'react-icons/fa';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ContactForm from '@/components/ContactForm.tsx';
import Todo from '@/components/Todo.astro';
import { site, isTodo } from '@/config/site';
import { formatPhone, mailtoUrl, telUrl, whatsappUrl, defaultWhatsappMessage } from '@/lib/contact';
import { breadcrumbLd } from '@/lib/schema';

const siteUrl = Astro.site ?? new URL('https://example.com');
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact' },
];
const { contact, location, owner } = site;
const firstName = owner.name.split(' ')[0];
const city = location.city;
const wa = whatsappUrl(defaultWhatsappMessage());
const tel = telUrl();
const mail = mailtoUrl('Enquiry');
const area = [location.city, location.state].filter(Boolean).join(', ');
const address = [location.streetAddress, area, location.postalCode].filter(Boolean).join(', ');
---
<BaseLayout
  title={city ? `Contact: tax filing help in ${city}` : 'Contact: WhatsApp, call or send an enquiry'}
  description={`Contact ${owner.name} (${site.brandName}) for ITR, GST, TDS or challan help. WhatsApp, call or send a short enquiry and get a checklist and quote.`}
  jsonLd={[breadcrumbLd(siteUrl, crumbs)]}
>
  <PageHeader
    title="Contact"
    meta="Form · Enquiry"
    lead={`WhatsApp is usually the quickest way to reach ${firstName}. You can also call, or fill in the enquiry slip and you’ll be contacted back.`}
    crumbs={crumbs}
  />

  <section class="contact" aria-label="Ways to get in touch">
    <div class="container contact-grid">
      <div class="slip sheet sheet--stacked">
        <div class="slip-head" aria-hidden="true">
          <span>{site.brandName}</span>
          <span>Enquiry slip</span>
        </div>
        <h2 class="slip-title">Send an enquiry</h2>
        <p class="slip-lead">A few details are enough. You’ll get a reply with a document checklist and a quote.</p>
        <ContactForm client:load />
      </div>

      <aside class="channels desk desk--raised" aria-labelledby="channels-title">
        <h2 id="channels-title" class="channels-title">Or reach {firstName} directly</h2>

        <a
          class="btn btn--whatsapp btn--lg btn--block wa-big"
          href={wa ?? '#channels-title'}
          target={wa ? '_blank' : undefined}
          rel={wa ? 'noopener' : undefined}
          aria-describedby={wa ? undefined : 'wa-missing'}
        >
          <FaWhatsapp aria-hidden="true" /> Message on WhatsApp
        </a>
        {!wa && <p id="wa-missing" class="small missing"><Todo label="WhatsApp number" /></p>}

        <ul class="channel-list" role="list">
          <li>
            <Phone aria-hidden="true" />
            <div>
              <p class="ch-label">Phone</p>
              <p class="ch-value">{tel ? <a href={tel}>{formatPhone(contact.phone)}</a> : <Todo label="phone number" />}</p>
            </div>
          </li>
          <li>
            <Mail aria-hidden="true" />
            <div>
              <p class="ch-label">Email</p>
              <p class="ch-value">{mail ? <a href={mail}>{contact.email}</a> : <Todo label="email" />}</p>
            </div>
          </li>
          <li>
            <Clock aria-hidden="true" />
            <div>
              <p class="ch-label">Working hours</p>
              <p class="ch-value">{contact.hoursLabel ?? <Todo label="working hours" />}</p>
            </div>
          </li>
          <li>
            <MapPin aria-hidden="true" />
            <div>
              <p class="ch-label">Location</p>
              <p class="ch-value">{address || <Todo label="city / areas served" />}</p>
              {location.areasServed.length > 0 && <p class="ch-sub">Areas served: {location.areasServed.join(', ')}</p>}
              <p class="ch-sub">{isTodo(location.mode) ? <Todo label="in person, online, or both" /> : location.mode}</p>
            </div>
          </li>
        </ul>

        <div class="docs-note">
          <p class="stamp stamp--sm stamp--forest docs-stamp" aria-hidden="true">Note</p>
          <p>
            <strong>Sending documents?</strong> Please don’t send PAN, Aadhaar or other documents through the form. Once you decide
            to go ahead, share them on WhatsApp or in person.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    padding-bottom: var(--space-2xl);
  }
  .contact-grid {
    display: grid;
    gap: var(--space-l);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .contact-grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      gap: var(--space-xl);
    }
    .channels {
      position: sticky;
      top: calc(var(--header-h) + var(--space-m));
    }
  }

  /* ---------- enquiry slip ---------- */
  .slip {
    /* Perforated top edge: a row of punched dots, like a slip torn from a pad. */
    padding-top: calc(var(--sheet-pad) + 0.75rem);
    background-image: radial-gradient(circle at 7px 7px, var(--paper-100) 3.5px, transparent 4px);
    background-size: 18px 14px;
    background-repeat: repeat-x;
    background-position: 2px 4px;
  }
  .slip-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-s);
    padding-bottom: var(--space-2xs);
    margin-bottom: var(--space-m);
    font-family: var(--font-paper);
    font-size: var(--step--2);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--graphite-500);
    border-bottom: 1.5px solid var(--graphite-900);
  }
  .slip-title {
    font-size: var(--step-2);
    margin-bottom: var(--space-2xs);
  }
  .slip-lead {
    color: var(--graphite-700);
    margin-bottom: var(--space-m);
    max-width: 48ch;
  }

  /* ---------- direct channels (desk) ---------- */
  .channels {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: var(--radius-ui);
  }
  .channels-title {
    font-size: var(--step-2);
    color: var(--paper-50);
    margin-bottom: var(--space-m);
  }
  .wa-big {
    min-height: 60px;
    font-size: 1.125rem;
  }
  .wa-big :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }
  .missing {
    margin: var(--space-2xs) 0 0;
  }
  .channel-list {
    list-style: none;
    padding: 0;
    margin: var(--space-l) 0;
    display: grid;
  }
  .channel-list li {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: var(--space-s);
    align-items: start;
    margin: 0;
    padding-block: var(--space-s);
    border-top: 1px solid var(--line-desk);
  }
  .channel-list li:last-child {
    border-bottom: 1px solid var(--line-desk);
  }
  .channel-list :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.2rem;
    color: var(--mint-300);
  }
  .channel-list p {
    margin: 0;
  }
  .ch-label {
    font-size: var(--step--1);
    color: var(--ink-desk-2);
  }
  .ch-value {
    font-weight: 650;
    font-size: 1.0625rem;
  }
  .ch-value a {
    display: inline-block;
    padding-block: 0.35rem;
  }
  .ch-sub {
    font-size: var(--step--1);
    color: var(--ink-desk-2);
    margin-top: var(--space-3xs) !important;
  }
  .docs-note {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
  }
  .docs-note p {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--ink-desk-2);
  }
  .docs-note strong {
    color: var(--paper-50);
  }
  .docs-stamp {
    --stamp-tilt: -3deg;
  }
</style>
