---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { ArrowRight, Clock, ExternalLink, Landmark } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ContactButtons from '@/components/ContactButtons.astro';
import ChecklistSheet from '@/components/ChecklistSheet.astro';
import TalkCard from '@/components/TalkCard.astro';
import Faq from '@/components/Faq.astro';
import { codeFor, folio } from '@/components/service-codes';
import { site, type ServiceSlug } from '@/config/site';
import { serviceMeta } from '@/config/nav';
import { breadcrumbLd, faqLd, serviceLd } from '@/lib/schema';

export async function getStaticPaths() {
  const entries = (
    await getCollection('services', ({ id, data }) => !data.draft && site.services[id as ServiceSlug] === true)
  ).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, index: i + 1 } }));
}

interface Props { entry: CollectionEntry<'services'>; index: number }
const { entry, index } = Astro.props;
const { data } = entry;
const slug = entry.id as ServiceSlug;
const meta = serviceMeta[slug];
const name = meta?.title ?? data.title;
const topic = meta?.whatsappTopic ?? data.title;
const { code } = codeFor(slug);
const { Content } = await render(entry);

const siteUrl = Astro.site ?? new URL('https://example.com');
const path = `/services/${slug}`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Services', path: '/services' },
  { name: data.title, path },
];
const city = site.location.city;
const seoTitle = city ? `${data.seoTitle} in ${city}` : data.seoTitle;
const enquiryHref = `/contact?service=${encodeURIComponent(slug)}`;

const jsonLd = [
  serviceLd(siteUrl, { name: data.title, path, description: data.description }),
  breadcrumbLd(siteUrl, crumbs),
  ...(data.faqs.length ? [faqLd(data.faqs)] : []),
];

// Form-style section letters, assigned in page order.
const sections = [
  { id: 'who', label: 'Who it’s for' },
  { id: 'included', label: 'What’s included' },
  { id: 'documents', label: 'Documents' },
  { id: 'process', label: 'Process' },
  { id: 'pricing', label: 'Pricing' },
  ...(data.faqs.length ? [{ id: 'faqs', label: 'Questions' }] : []),
  ...(data.officialLinks.length ? [{ id: 'links', label: 'Official portals' }] : []),
];
const letter = (id: string) => String.fromCharCode(65 + sections.findIndex((s) => s.id === id));
const hostOf = (url: string) => new URL(url).hostname.replace(/^www\./, '');
---
<BaseLayout title={seoTitle} description={data.description} jsonLd={jsonLd} whatsappTopic={topic}>
  <PageHeader title={data.title} lead={data.description} crumbs={crumbs} meta={`Service · ${folio(index)} / ${code}`}>
    <div class="cover-actions">
      <ContactButtons topic={topic} />
      <span class="pill">Pricing: {site.pricing}</span>
    </div>
  </PageHeader>

  <div class="container svc-layout">
    <article class="svc-main">
      <nav class="jump" aria-label="On this page">
        <ol role="list">
          {sections.map((s) => (
            <li><a href={`#${s.id}`}><span class="jump-letter" aria-hidden="true">{letter(s.id)}</span>{s.label}</a></li>
          ))}
        </ol>
      </nav>

      <div class="sheet svc-sheet">
        <div class="prose svc-intro"><Content /></div>

        <section class="svc-part" aria-labelledby="who">
          <h2 id="who"><span class="part" aria-hidden="true">{letter('who')}</span>Who it’s for</h2>
          <ul class="who-list" role="list">
            {data.whoFor.map((item) => <li>{item}</li>)}
          </ul>
        </section>

        <section class="svc-part" aria-labelledby="included">
          <h2 id="included"><span class="part" aria-hidden="true">{letter('included')}</span>What’s included</h2>
          <ul class="checklist included">
            {data.included.map((item) => <li>{item}</li>)}
          </ul>
          <p class="svc-small">Scope is agreed with you before work starts. Anything outside it is quoted separately.</p>
        </section>
      </div>

      <ChecklistSheet
        id="documents"
        part={letter('documents')}
        service={name}
        code={code}
        topic={topic}
        fallbackHref={enquiryHref}
        groups={data.documents}
      />

      <div class="sheet svc-sheet">
        <section class="svc-part" aria-labelledby="process">
          <h2 id="process"><span class="part" aria-hidden="true">{letter('process')}</span>Process and timeline</h2>
          <ol class="timeline" role="list">
            {data.process.map((s, i) => (
              <li>
                <span class="tl-no" aria-hidden="true">{folio(i + 1)}</span>
                <div class="tl-body">
                  <h3><span class="visually-hidden">Step {i + 1}: </span>{s.step}</h3>
                  <p>{s.detail}</p>
                </div>
              </li>
            ))}
          </ol>
          <div class="notice notice--info tl-note">
            <Clock aria-hidden="true" />
            <p><strong>Typical timeline.</strong> {data.timeline}</p>
          </div>
        </section>

        <section class="svc-part" aria-labelledby="pricing">
          <h2 id="pricing"><span class="part" aria-hidden="true">{letter('pricing')}</span>Pricing: {site.pricing}</h2>
          <p class="svc-p">
            The fee depends on your case: how many income sources or invoices there are, how organised the documents are and how often
            the work repeats. Share a few details and you’ll get a clear quote before any work starts.
          </p>
          <div class="cluster">
            <ContactButtons topic={topic} />
            <a class="btn btn--ghost" href={enquiryHref}>Send an enquiry</a>
          </div>
        </section>

        {data.faqs.length > 0 && (
          <section class="svc-part" aria-labelledby="faqs">
            <h2 id="faqs"><span class="part" aria-hidden="true">{letter('faqs')}</span>Questions about {name}</h2>
            <Faq faqs={data.faqs} />
            <p class="more-faq"><a class="link-arrow" href="/faq">More questions <ArrowRight aria-hidden="true" /></a></p>
          </section>
        )}

        {data.officialLinks.length > 0 && (
          <section class="svc-part" aria-labelledby="links">
            <h2 id="links"><span class="part" aria-hidden="true">{letter('links')}</span>Official portals</h2>
            <p class="svc-small">Government portals for your reference. {site.brandName} is not affiliated with any government department.</p>
            <ul class="portals" role="list">
              {data.officialLinks.map((l) => (
                <li>
                  <a class="portal" href={l.url} rel="noopener">
                    <Landmark className="portal-icon" aria-hidden="true" />
                    <span class="portal-text">
                      <span class="portal-label">{l.label}</span>
                      <span class="portal-host">{hostOf(l.url)}</span>
                    </span>
                    <ExternalLink className="portal-ext" aria-hidden="true" />
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </article>

    <div class="svc-aside">
      <div class="svc-aside-inner">
        <TalkCard service={name} topic={topic} code={code} enquiryHref={enquiryHref} />
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .cover-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-s);
  }
  @media (min-width: 60rem) {
    /* The sticky card takes over on desktop. */
    .cover-actions {
      display: none;
    }
  }

  .svc-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
    padding-bottom: var(--space-xl);
  }
  @media (min-width: 60rem) {
    .svc-layout {
      grid-template-columns: minmax(0, 1fr) 20rem;
      gap: var(--space-l) clamp(2rem, 1rem + 2vw, 3.5rem);
      align-items: start;
    }
  }
  .svc-main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-m);
    min-width: 0;
  }
  .jump {
    min-width: 0;
    max-width: 100%;
  }

  /* Jump index: small file tabs. */
  .jump ol {
    display: flex;
    gap: 0.4rem;
    margin: 0;
    padding: 0 0 0.25rem;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .jump ol::-webkit-scrollbar {
    display: none;
  }
  .jump li {
    flex: none;
    margin: 0;
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: var(--tap);
    padding: 0 0.8rem 0 0.45rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--graphite-700);
    text-decoration: none;
    background: var(--paper-200);
    border: 1px solid var(--paper-300);
    border-radius: 8px;
    transition: transform var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .jump a:hover {
    color: var(--graphite-900);
    background: var(--paper-50);
    transform: translateY(-2px);
  }
  .jump-letter {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    font-family: var(--font-paper);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--paper-50);
    background: var(--graphite-700);
    border-radius: 4px;
  }

  .svc-sheet {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
  }
  .svc-intro :global(p) {
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.65;
    color: var(--graphite-700);
  }
  .svc-intro :global(p:first-child) {
    color: var(--graphite-900);
  }
  .svc-intro :global(p:last-child) {
    margin-bottom: 0;
  }
  .svc-part {
    padding-top: var(--space-l);
    border-top: 1px solid var(--paper-300);
  }
  .svc-sheet > .svc-part:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .svc-part h2 {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--step-2);
    margin-bottom: var(--space-s);
  }
  .svc-small {
    margin: var(--space-s) 0 0;
    font-size: var(--step--1);
    color: var(--graphite-500);
  }
  .svc-p {
    max-width: var(--measure);
    color: var(--graphite-700);
  }

  .who-list {
    display: grid;
    gap: var(--space-2xs) var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .who-list li {
    position: relative;
    margin: 0;
    padding-left: 1.4rem;
  }
  .who-list li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.62em;
    width: 0.6rem;
    height: 2px;
    background: var(--forest-700);
    border-radius: 2px;
  }
  .included {
    display: grid;
    gap: var(--space-xs) var(--space-l);
    margin: 0;
  }
  .included :global(li) {
    margin: 0;
  }
  @media (min-width: 48rem) {
    .who-list,
    .included {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Process: numbered steps joined by a perforated line. */
  .timeline {
    margin: 0 0 var(--space-m);
    padding: 0;
    list-style: none;
  }
  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    gap: var(--space-s);
    margin: 0;
    padding-bottom: var(--space-m);
  }
  .timeline li:last-child {
    padding-bottom: 0;
  }
  .timeline li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(1.625rem - 1px);
    top: 3.25rem;
    bottom: 0.4rem;
    border-left: 2px dotted var(--line-strong);
  }
  .tl-no {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    font-stretch: 80%;
    font-variant-numeric: tabular-nums;
    color: var(--forest-700);
    background: var(--mint-100);
    border: 1.5px solid color-mix(in oklch, var(--forest-700) 35%, transparent);
    border-radius: 50%;
  }
  .timeline li:last-child .tl-no {
    color: var(--paper-50);
    background: var(--forest-700);
    border-color: var(--forest-700);
  }
  .tl-body {
    padding-top: 0.55rem;
  }
  .tl-body h3 {
    margin-bottom: var(--space-3xs);
    font-size: 1.1875rem;
  }
  .tl-body p {
    margin: 0;
    max-width: 60ch;
    color: var(--graphite-700);
  }
  .tl-note p {
    margin: 0;
  }

  .more-faq {
    margin: var(--space-xs) 0 0;
  }

  /* Official portal chips. */
  .portals {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: var(--space-s) 0 0;
    padding: 0;
    list-style: none;
  }
  .portals li {
    margin: 0;
    max-width: 100%;
  }
  .portal {
    display: inline-grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.7rem;
    max-width: 100%;
    min-height: 3.25rem;
    padding: 0.45rem 1rem 0.45rem 0.55rem;
    color: var(--graphite-900);
    text-decoration: none;
    background: var(--paper-50);
    border: 1.5px solid var(--paper-300);
    border-radius: var(--radius-pill);
    transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .portal:hover {
    color: var(--graphite-900);
    border-color: var(--forest-600);
    transform: translateY(-2px);
  }
  .portal :global(.portal-icon) {
    box-sizing: content-box;
    width: 1.05rem;
    height: 1.05rem;
    padding: 0.5rem;
    color: var(--forest-700);
    background: var(--mint-100);
    border-radius: 50%;
  }
  .portal-text {
    display: grid;
    min-width: 0;
    line-height: 1.3;
  }
  .portal-label {
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .portal-host {
    font-family: var(--font-paper);
    font-size: var(--step--2);
    color: var(--graphite-500);
    overflow-wrap: anywhere;
  }
  .portal :global(.portal-ext) {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--graphite-500);
  }

  @media (min-width: 60rem) {
    .svc-aside-inner {
      position: sticky;
      top: calc(var(--header-h) - var(--header-shrink) + 1.5rem);
    }
  }

  @media print {
    .jump,
    .svc-aside {
      display: none;
    }
  }
</style>
